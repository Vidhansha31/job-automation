# Copy this file to .env and fill it in.

# The long ID in your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
# (Optional: if empty, the sheet named "Job Tracker" is opened by name.)
SHEET_ID=

# Optional: comma-separated proxies for LinkedIn/Indeed scraping (user:pass@host:port).
# Leave empty to use your normal home connection (recommended).
JOBSPY_PROXIES=

# Free AI keys for resume tailoring (add at least one; all three = best reliability).
# Gemini:     https://aistudio.google.com/apikey
# Groq:       https://console.groq.com/keys
# OpenRouter: https://openrouter.ai/keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
